      <COMP relation="Descriptor">
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="540b57cb-4220-4077-8a39-70b33a25ede7"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[правляет действиями администратора (создание броней по телефону). Зависимость от Client, BookingController, Authoruzation. Если клиента нет в базе, метод registerClientByPhone вызывает метод register из AuthorizationController, который и регистрирует клиента. Подразумевается, что метод createBookingForClient вызывает метод CreateBooking из BookingController для создания новой брони для клиента.]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
            <LINK relation="Model">
              <FOREIGNID name="description" mc="Infrastructure.NoteType" uid="00000000-0000-3e81-0000-000000000000"/>
            </LINK>
          </DEPENDENCIES>
        </OBJECT>
      </COMP>
