      <COMP relation="Descriptor">
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="1d3243ed-6fde-4ddb-8da0-d4ba92ce93bc"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[...Автоматически присвоить клиенту VIP-статус и предоставить скидки при регулярном посещении.
Основной поток:
10.1. Система анализирует историю бронирований и посещений клиента за определённый период.
10.2. Система проверяет, превышает ли количество оплаченных броней установленный порог.
10.3. Если порог в момент оплаты очередной брони превышен, Система автоматически присваивает клиенту статус «VIP-клиент».
10.4. Система применяет скидку к стоимости будущих бронирований данного клиента.
10.5. Система уведомляет клиента о присвоении VIP-статуса и размере скидки.
]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
            <LINK relation="Model">
              <FOREIGNID name="description" mc="Infrastructure.NoteType" uid="00000000-0000-3e81-0000-000000000000"/>
            </LINK>
          </DEPENDENCIES>
        </OBJECT>
